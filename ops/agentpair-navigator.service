[Unit]
Description=AgentPair Navigator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentpair
Group=agentpair
WorkingDirectory=/opt/agentpair
ExecStart=/opt/agentpair/venv/bin/python -m agentpair.platform --database /var/lib/agentpair/tasks.db --driver pending --key /var/lib/agentpair/driver_key --known-hosts /var/lib/agentpair/known_hosts --port 9090 --origin https://50.118.187.180
StandardInput=file:/etc/agentpair/private.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agentpair
PrivateTmp=true

[Install]
WantedBy=multi-user.target
